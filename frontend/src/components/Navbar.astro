---
import { es } from '../lib/i18n/es';
import type { AuthUser } from '../types/auth';

interface Props {
  currentPath: string;
  user?: AuthUser | null;
}

const { currentPath, user = null } = Astro.props;

const canViewSales = user?.role === 'admin' || user?.role === 'cashier';

const navItems = [
  { href: '/', label: es.nav.home, active: currentPath === '/' },
  {
    href: '/orders',
    label: es.nav.orders,
    active: currentPath === '/orders' || currentPath.startsWith('/orders/'),
  },
  ...(canViewSales
    ? [
        {
          href: '/sales',
          label: es.nav.sales,
          active: currentPath === '/sales' || currentPath.startsWith('/sales/'),
        },
      ]
    : []),
  {
    href: '/waiters',
    label: es.nav.waiters,
    active: currentPath === '/waiters' || currentPath.startsWith('/waiters/'),
  },
  {
    href: '/tables',
    label: es.nav.tables,
    active: currentPath === '/tables' || currentPath.startsWith('/tables/'),
  },
  {
    href: '/products',
    label: es.nav.products,
    active: currentPath === '/products' || currentPath.startsWith('/products/'),
  },
  {
    href: '/categories',
    label: es.nav.categories,
    active:
      currentPath === '/categories' || currentPath.startsWith('/categories/'),
  },
];
---

<header class="border-b border-border bg-surface-card">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <a
      href="/"
      class="inline-flex items-baseline gap-2 text-lg font-bold tracking-tight text-ink no-underline"
    >
      <span class="text-brand-strong">{es.app.brand}</span>
      <span class="text-sm font-medium text-ink-muted">{es.app.tagline}</span>
    </a>

    {user !== null && (
      <div class="flex flex-wrap items-center gap-4">
        <nav aria-label={es.nav.ariaLabel}>
          <ul class="flex flex-wrap items-center gap-2">
            {navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={item.active ? 'page' : undefined}
                  class:list={[
                    'inline-flex items-center rounded-md px-3 py-2 text-sm font-medium transition-colors',
                    item.active
                      ? 'border-b-2 border-brand-strong bg-brand-soft font-semibold text-brand-strong'
                      : 'text-ink-muted hover:bg-surface hover:text-ink',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="flex items-center gap-2 border-l border-border pl-4">
          <div class="text-right">
            <p class="text-xs font-semibold text-ink">{user.name}</p>
            <p class="text-[11px] text-ink-muted">
              {es.auth.roleLabels[user.role]}
            </p>
          </div>
          <form method="POST" action="/api/auth/logout">
            <button
              type="submit"
              class="inline-flex min-h-9 items-center rounded-md border border-border px-2.5 py-1 text-xs font-semibold text-ink-muted transition-colors hover:bg-surface hover:text-ink"
            >
              {es.nav.logout}
            </button>
          </form>
        </div>
      </div>
    )}
  </div>
</header>
