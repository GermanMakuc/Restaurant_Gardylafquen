---
import { es } from '../../lib/i18n/es';

interface Props {
  initialError?: string | null;
}

const { initialError = null } = Astro.props;
---

<section class="mx-auto max-w-md py-8 sm:py-12">
  <div class="rounded-2xl border border-border bg-surface-card p-6 shadow-xs sm:p-8">
    <div class="space-y-1">
      <h1 class="text-2xl font-bold tracking-tight text-ink">
        {es.auth.heading}
      </h1>
      <p class="text-sm text-ink-muted">{es.auth.subtitle}</p>
    </div>

    <form
      id="login-form"
      method="POST"
      action="/api/auth/login"
      novalidate
      class="mt-6 space-y-4"
    >
      <div class="space-y-1.5">
        <label for="login-email" class="block text-sm font-medium text-ink">
          {es.auth.emailLabel}
        </label>
        <input
          id="login-email"
          name="email"
          type="email"
          autocomplete="username"
          inputmode="email"
          spellcheck="false"
          autocapitalize="none"
          enterkeyhint="next"
          required
          placeholder={es.auth.emailPlaceholder}
          class="min-h-11 w-full rounded-lg border border-border bg-white px-3 py-2 text-sm text-ink"
        />
      </div>

      <div class="space-y-1.5">
        <label for="login-password" class="block text-sm font-medium text-ink">
          {es.auth.passwordLabel}
        </label>
        <div class="relative flex items-center">
          <input
            id="login-password"
            name="password"
            type="password"
            autocomplete="current-password"
            enterkeyhint="done"
            required
            class="min-h-11 w-full rounded-lg border border-border bg-white py-2 pr-20 pl-3 text-sm text-ink"
          />
          <button
            id="toggle-password"
            type="button"
            aria-pressed="false"
            aria-label={es.auth.showPasswordAria}
            class="absolute right-2 inline-flex min-h-8 items-center rounded-md px-2.5 text-xs font-semibold text-ink-muted hover:bg-surface hover:text-ink"
          >
            {es.auth.showPassword}
          </button>
        </div>
      </div>

      <p
        id="login-error"
        role="alert"
        hidden={initialError === null}
        class="rounded-lg border border-danger/30 bg-danger-soft px-3 py-2 text-sm font-medium text-danger"
      >
        {initialError ?? ''}
      </p>

      <button
        id="login-submit"
        type="submit"
        class="inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-brand px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-strong"
      >
        {es.auth.submitButton}
      </button>
    </form>
  </div>
</section>

<script>
  import { initLoginForm } from './loginClient';

  initLoginForm();
</script>
