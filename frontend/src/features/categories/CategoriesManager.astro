---
import { es } from '../../lib/i18n/es';
import type { PaginatedResponse } from '../../types/api';
import type { Category } from '../../types/category';

interface Props {
  result: PaginatedResponse<Category> | null;
  searchQuery: string;
  loadFailed: boolean;
  canManage?: boolean;
}

const { result, searchQuery, loadFailed, canManage = true } = Astro.props;
const categories = result?.data ?? [];
const meta = result?.meta;

const buildPageHref = (page: number): string => {
  const params = new URLSearchParams();
  if (searchQuery.trim() !== '') {
    params.set('q', searchQuery.trim());
  }
  params.set('page', String(page));
  return `/categories?${params.toString()}`;
};

const formatDate = (iso: string | null): string => {
  if (iso === null) {
    return '—';
  }
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) {
    return '—';
  }
  return new Intl.DateTimeFormat('es-CL', {
    dateStyle: 'medium',
  }).format(date);
};
---

<section class="space-y-6">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="space-y-1">
      <h1 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
        {es.categories.heading}
      </h1>
      <p class="text-sm text-ink-muted sm:text-base">
        {es.categories.subtitle}
      </p>
    </div>

    {canManage && (
      <button
        id="open-create-category"
        type="button"
        class="inline-flex min-h-11 items-center rounded-lg bg-brand px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-strong"
      >
        {es.categories.addButton}
      </button>
    )}
  </div>

  <search>
    <form
      action="/categories"
      method="GET"
      class="flex flex-wrap items-end gap-3 rounded-xl border border-border bg-surface-card p-4 shadow-xs"
    >
      <div class="flex min-w-60 flex-1 flex-col gap-1.5">
        <label for="category-search" class="text-sm font-medium text-ink">
          {es.categories.searchLabel}
        </label>
        <input
          id="category-search"
          type="search"
          name="q"
          value={searchQuery}
          placeholder={es.categories.searchPlaceholder}
          class="min-h-11 rounded-lg border border-border bg-white px-3 py-2 text-sm text-ink"
        />
      </div>

      <div class="flex items-center gap-2">
        <button
          type="submit"
          class="inline-flex min-h-11 items-center rounded-lg border border-brand bg-brand-soft px-4 py-2 text-sm font-semibold text-brand-strong transition-colors hover:bg-brand hover:text-white"
        >
          {es.categories.searchButton}
        </button>

        {searchQuery.trim() !== '' && (
          <a
            href="/categories"
            class="inline-flex min-h-11 items-center rounded-lg border border-border px-4 py-2 text-sm font-medium text-ink-muted hover:bg-surface hover:text-ink"
          >
            {es.categories.clearSearch}
          </a>
        )}
      </div>
    </form>
  </search>

  {loadFailed && (
    <div
      role="alert"
      class="rounded-xl border border-danger/30 bg-danger-soft p-4 text-sm font-medium text-danger"
    >
      {es.categories.loadError}
    </div>
  )}

  <div class="overflow-hidden rounded-xl border border-border bg-surface-card shadow-xs">
    {categories.length === 0 ? (
      <p class="p-8 text-center text-sm text-ink-muted">
        {searchQuery.trim() !== ''
          ? es.categories.emptyFiltered
          : es.categories.emptyTitle}
      </p>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left text-sm">
          <caption class="sr-only">{es.categories.tableCaption}</caption>
          <thead class="border-b border-border bg-surface text-xs font-semibold uppercase tracking-wide text-ink-muted">
            <tr>
              <th scope="col" class="px-4 py-3">
                {es.categories.colName}
              </th>
              <th scope="col" class="px-4 py-3">
                {es.categories.colCreatedAt}
              </th>
              {canManage && (
                <th scope="col" class="px-4 py-3 text-right">
                  {es.categories.colActions}
                </th>
              )}
            </tr>
          </thead>
          <tbody class="divide-y divide-border/70">
            {categories.map((category) => (
              <tr class="hover:bg-surface/60">
                <td class="px-4 py-3 font-medium text-ink">{category.name}</td>
                <td class="px-4 py-3 text-ink-muted">
                  {formatDate(category.created_at)}
                </td>
                {canManage && (
                  <td class="px-4 py-3 text-right">
                    <div class="inline-flex items-center justify-end gap-2">
                      <button
                        type="button"
                        data-action="edit-category"
                        data-category-id={String(category.id)}
                        data-category-name={category.name}
                        aria-label={`${es.categories.editButton} ${category.name}`}
                        class="inline-flex min-h-9 items-center rounded-md border border-border px-3 py-1.5 text-xs font-semibold text-ink hover:bg-surface"
                      >
                        {es.categories.editButton}
                      </button>
                      <button
                        type="button"
                        data-action="delete-category"
                        data-category-id={String(category.id)}
                        data-category-name={category.name}
                        aria-label={`${es.categories.deleteButton} ${category.name}`}
                        class="inline-flex min-h-9 items-center rounded-md border border-danger/30 bg-danger-soft px-3 py-1.5 text-xs font-semibold text-danger hover:bg-danger hover:text-white"
                      >
                        {es.categories.deleteButton}
                      </button>
                    </div>
                  </td>
                )}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>

  {meta !== undefined && meta.last_page > 1 && (
    <nav
      aria-label={es.categories.tableCaption}
      class="flex flex-wrap items-center justify-between gap-4 text-sm"
    >
      <p class="text-ink-muted">
        {es.categories.paginationSummary(
          meta.current_page,
          meta.last_page,
          meta.total,
        )}
      </p>

      <div class="flex items-center gap-2">
        {meta.current_page > 1 && (
          <a
            href={buildPageHref(meta.current_page - 1)}
            class="inline-flex min-h-10 items-center rounded-lg border border-border bg-surface-card px-3 py-2 font-medium text-ink hover:bg-surface"
          >
            {es.categories.paginationPrev}
          </a>
        )}
        {meta.current_page < meta.last_page && (
          <a
            href={buildPageHref(meta.current_page + 1)}
            class="inline-flex min-h-10 items-center rounded-lg border border-border bg-surface-card px-3 py-2 font-medium text-ink hover:bg-surface"
          >
            {es.categories.paginationNext}
          </a>
        )}
      </div>
    </nav>
  )}

  <dialog
    id="category-form-dialog"
    closedby="any"
    aria-labelledby="category-form-title"
    class="m-auto w-[min(92dvw,28rem)] rounded-xl border border-border bg-surface-card p-6 text-ink shadow-xl"
  >
    <div class="flex items-start justify-between gap-4">
      <h1 id="category-form-title" class="text-lg font-bold text-ink">
        {es.categories.modalCreateTitle}
      </h1>
      <form method="dialog">
        <button
          type="submit"
          value="close"
          class="rounded-md px-2.5 py-1 text-sm font-medium text-ink-muted hover:bg-surface hover:text-ink"
        >
          {es.categories.closeButton}
        </button>
      </form>
    </div>

    <form id="category-form" novalidate class="mt-4 space-y-4">
      <div class="flex flex-col gap-1.5">
        <label for="category-name" class="text-sm font-medium text-ink">
          {es.categories.nameLabel}
        </label>
        <span id="category-name-hint" class="text-xs text-ink-muted">
          {es.categories.nameHint}
        </span>
        <input
          id="category-name"
          name="name"
          type="text"
          required
          minlength="2"
          maxlength="100"
          autofocus
          aria-describedby="category-name-hint category-form-error"
          class="min-h-11 rounded-lg border border-border bg-white px-3 py-2 text-sm text-ink"
        />
        <p
          id="category-form-error"
          role="alert"
          hidden
          class="text-xs font-medium text-danger"
        ></p>
      </div>

      <div class="flex items-center justify-end gap-2 pt-2">
        <button
          type="submit"
          formmethod="dialog"
          formnovalidate
          value="cancel"
          class="inline-flex min-h-10 items-center rounded-lg border border-border px-4 py-2 text-sm font-medium text-ink-muted hover:bg-surface hover:text-ink"
        >
          {es.categories.cancelButton}
        </button>
        <button
          id="category-submit-btn"
          type="submit"
          class="inline-flex min-h-10 items-center rounded-lg bg-brand px-4 py-2 text-sm font-semibold text-white hover:bg-brand-strong disabled:opacity-60"
        >
          {es.categories.saveButton}
        </button>
      </div>
    </form>
  </dialog>

  <dialog
    id="category-delete-dialog"
    closedby="any"
    aria-labelledby="category-delete-title"
    class="m-auto w-[min(92dvw,28rem)] rounded-xl border border-border bg-surface-card p-6 text-ink shadow-xl"
  >
    <h1 id="category-delete-title" class="text-lg font-bold text-ink">
      {es.categories.deleteTitle}
    </h1>
    <p id="category-delete-warning" class="mt-2 text-sm text-ink-muted"></p>
    <p
      id="category-delete-error"
      role="alert"
      hidden
      class="mt-3 text-xs font-medium text-danger"
    ></p>

    <div class="mt-6 flex items-center justify-end gap-2">
      <form method="dialog">
        <button
          type="submit"
          value="cancel"
          autofocus
          class="inline-flex min-h-10 items-center rounded-lg border border-border px-4 py-2 text-sm font-medium text-ink hover:bg-surface"
        >
          {es.categories.cancelButton}
        </button>
      </form>
      <button
        id="category-confirm-delete-btn"
        type="button"
        class="inline-flex min-h-10 items-center rounded-lg bg-danger px-4 py-2 text-sm font-semibold text-white hover:opacity-90 disabled:opacity-60"
      >
        {es.categories.confirmDeleteButton}
      </button>
    </div>
  </dialog>
</section>

<script>
  import { initCategoriesManager } from './categoriesClient';

  initCategoriesManager();
</script>
