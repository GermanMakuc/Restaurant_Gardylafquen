---
import { formatPriceFromCents } from '../../lib/format/currency';
import { es } from '../../lib/i18n/es';
import type { PaginatedResponse } from '../../types/api';
import type { Order, OrderStatus } from '../../types/order';
import type { Product } from '../../types/product';
import type { RestaurantTable } from '../../types/table';
import type { Waiter } from '../../types/waiter';

interface Props {
  result: PaginatedResponse<Order> | null;
  tables: RestaurantTable[];
  waiters: Waiter[];
  products: Product[];
  selectedStatus: string;
  loadFailed: boolean;
}

const { result, tables, waiters, products, selectedStatus, loadFailed } =
  Astro.props;
const orders = result?.data ?? [];
const meta = result?.meta;
const statuses: OrderStatus[] = ['waiting', 'served', 'paid', 'cancelled'];

const buildPageHref = (page: number): string => {
  const params = new URLSearchParams();
  if (selectedStatus !== '') {
    params.set('status', selectedStatus);
  }
  params.set('page', String(page));
  return `/orders?${params.toString()}`;
};
---

<section class="space-y-6">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="space-y-1">
      <h1 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
        {es.orders.heading}
      </h1>
      <p class="text-sm text-ink-muted sm:text-base">{es.orders.subtitle}</p>
    </div>

    <button
      id="open-create-order"
      type="button"
      class="inline-flex min-h-11 items-center rounded-lg bg-brand px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-strong"
    >
      {es.orders.addButton}
    </button>
  </div>

  <search>
    <form
      action="/orders"
      method="GET"
      class="flex flex-wrap items-end gap-3 rounded-xl border border-border bg-surface-card p-4 shadow-xs"
    >
      <div class="flex min-w-52 flex-1 flex-col gap-1.5">
        <label for="order-status-filter" class="text-sm font-medium text-ink">
          {es.orders.statusFilterLabel}
        </label>
        <select
          id="order-status-filter"
          name="status"
          class="min-h-11 rounded-lg border border-border bg-white px-3 py-2 text-sm text-ink"
        >
          <option value="">{es.orders.allStatuses}</option>
          {statuses.map((st) => (
            <option value={st} selected={selectedStatus === st}>
              {es.orders.statusLabels[st]}
            </option>
          ))}
        </select>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="submit"
          class="inline-flex min-h-11 items-center rounded-lg border border-brand bg-brand-soft px-4 py-2 text-sm font-semibold text-brand-strong transition-colors hover:bg-brand hover:text-white"
        >
          {es.orders.searchButton}
        </button>

        {selectedStatus !== '' && (
          <a
            href="/orders"
            class="inline-flex min-h-11 items-center rounded-lg border border-border px-4 py-2 text-sm font-medium text-ink-muted hover:bg-surface hover:text-ink"
          >
            {es.orders.clearSearch}
          </a>
        )}
      </div>
    </form>
  </search>

  {loadFailed && (
    <div
      role="alert"
      class="rounded-xl border border-danger/30 bg-danger-soft p-4 text-sm font-medium text-danger"
    >
      {es.orders.loadError}
    </div>
  )}

  <div class="overflow-hidden rounded-xl border border-border bg-surface-card shadow-xs">
    {orders.length === 0 ? (
      <p class="p-8 text-center text-sm text-ink-muted">
        {selectedStatus !== '' ? es.orders.emptyFiltered : es.orders.emptyTitle}
      </p>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left text-sm">
          <caption class="sr-only">{es.orders.tableCaption}</caption>
          <thead class="border-b border-border bg-surface text-xs font-semibold uppercase tracking-wide text-ink-muted">
            <tr>
              <th scope="col" class="px-4 py-3">
                {es.orders.colOrder}
              </th>
              <th scope="col" class="px-4 py-3">
                {es.orders.colTable}
              </th>
              <th scope="col" class="px-4 py-3">
                {es.orders.colWaiter}
              </th>
              <th scope="col" class="px-4 py-3">
                {es.orders.colItems}
              </th>
              <th scope="col" class="px-4 py-3">
                {es.orders.colSubtotal}
              </th>
              <th scope="col" class="px-4 py-3">
                {es.orders.colStatus}
              </th>
              <th scope="col" class="px-4 py-3 text-right">
                {es.orders.colActions}
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border/70">
            {orders.map((order) => {
              const isActive =
                order.status === 'waiting' || order.status === 'served';
              const orderItems = order.items ?? [];

              return (
                <tr class="hover:bg-surface/60">
                  <td class="px-4 py-3 font-semibold text-ink">#{order.id}</td>
                  <td class="px-4 py-3 text-ink">
                    {order.table
                      ? `#${order.table.number}`
                      : `#${order.table_id}`}
                  </td>
                  <td class="px-4 py-3 text-ink-muted">
                    {order.waiter?.name ?? `#${order.waiter_id}`}
                  </td>
                  <td class="px-4 py-3 text-xs text-ink-muted">
                    <ul class="space-y-0.5">
                      {orderItems.map((item) => (
                        <li>
                          {item.quantity} × {item.product_name}
                        </li>
                      ))}
                    </ul>
                    {order.notes !== null && (
                      <p class="mt-1 italic text-ink-muted">“{order.notes}”</p>
                    )}
                  </td>
                  <td class="px-4 py-3 font-semibold text-ink">
                    {formatPriceFromCents(order.subtotal_cents)}
                  </td>
                  <td class="px-4 py-3">
                    <span
                      class:list={[
                        'inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-semibold',
                        order.status === 'paid'
                          ? 'border-success/30 bg-success-soft text-success'
                          : order.status === 'cancelled'
                            ? 'border-danger/30 bg-danger-soft text-danger'
                            : 'border-brand/30 bg-brand-soft text-brand-strong',
                      ]}
                    >
                      <span
                        aria-hidden="true"
                        class:list={[
                          'inline-block size-1.5 rounded-full',
                          order.status === 'paid'
                            ? 'bg-success'
                            : order.status === 'cancelled'
                              ? 'bg-danger'
                              : 'bg-brand-strong',
                        ]}
                      />
                      <span>{es.orders.statusLabels[order.status]}</span>
                    </span>
                  </td>
                  <td class="px-4 py-3 text-right">
                    <div class="inline-flex flex-wrap items-center justify-end gap-1.5">
                      {isActive && (
                        <button
                          type="button"
                          data-action="edit-order"
                          data-order-id={String(order.id)}
                          data-order-table-id={String(order.table_id)}
                          data-order-waiter-id={String(order.waiter_id)}
                          data-order-notes={order.notes ?? ''}
                          data-order-items={JSON.stringify(orderItems)}
                          aria-label={`${es.orders.editButton} orden #${order.id}`}
                          class="inline-flex min-h-9 items-center rounded-md border border-border px-2.5 py-1 text-xs font-semibold text-ink hover:bg-surface"
                        >
                          {es.orders.editButton}
                        </button>
                      )}

                      {order.status === 'waiting' && (
                        <button
                          type="button"
                          data-action="status-order"
                          data-order-id={String(order.id)}
                          data-next-status="served"
                          aria-label={`${es.orders.markServedButton} orden #${order.id}`}
                          class="inline-flex min-h-9 items-center rounded-md border border-brand bg-brand-soft px-2.5 py-1 text-xs font-semibold text-brand-strong hover:bg-brand hover:text-white"
                        >
                          {es.orders.markServedButton}
                        </button>
                      )}

                      {order.status === 'served' && (
                        <button
                          type="button"
                          data-action="status-order"
                          data-order-id={String(order.id)}
                          data-next-status="waiting"
                          aria-label={`${es.orders.markWaitingButton} orden #${order.id}`}
                          class="inline-flex min-h-9 items-center rounded-md border border-border px-2.5 py-1 text-xs font-semibold text-ink hover:bg-surface"
                        >
                          {es.orders.markWaitingButton}
                        </button>
                      )}

                      {isActive && (
                        <button
                          type="button"
                          data-action="checkout-order"
                          data-order-id={String(order.id)}
                          data-order-subtotal-cents={String(
                            order.subtotal_cents,
                          )}
                          aria-label={`${es.orders.checkoutButton} orden #${order.id}`}
                          class="inline-flex min-h-9 items-center rounded-md border border-success/30 bg-success-soft px-2.5 py-1 text-xs font-semibold text-success hover:bg-success hover:text-white"
                        >
                          {es.orders.checkoutButton}
                        </button>
                      )}

                      {order.status !== 'paid' && (
                        <button
                          type="button"
                          data-action="delete-order"
                          data-order-id={String(order.id)}
                          aria-label={`${es.orders.deleteButton} orden #${order.id}`}
                          class="inline-flex min-h-9 items-center rounded-md border border-danger/30 bg-danger-soft px-2.5 py-1 text-xs font-semibold text-danger hover:bg-danger hover:text-white"
                        >
                          {es.orders.deleteButton}
                        </button>
                      )}
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </div>

  {meta !== undefined && meta.last_page > 1 && (
    <nav
      aria-label={es.orders.tableCaption}
      class="flex flex-wrap items-center justify-between gap-4 text-sm"
    >
      <p class="text-ink-muted">
        {es.orders.paginationSummary(
          meta.current_page,
          meta.last_page,
          meta.total,
        )}
      </p>

      <div class="flex items-center gap-2">
        {meta.current_page > 1 && (
          <a
            href={buildPageHref(meta.current_page - 1)}
            class="inline-flex min-h-10 items-center rounded-lg border border-border bg-surface-card px-3 py-2 font-medium text-ink hover:bg-surface"
          >
            {es.orders.paginationPrev}
          </a>
        )}
        {meta.current_page < meta.last_page && (
          <a
            href={buildPageHref(meta.current_page + 1)}
            class="inline-flex min-h-10 items-center rounded-lg border border-border bg-surface-card px-3 py-2 font-medium text-ink hover:bg-surface"
          >
            {es.orders.paginationNext}
          </a>
        )}
      </div>
    </nav>
  )}

  <dialog
    id="order-form-dialog"
    closedby="any"
    aria-labelledby="order-form-title"
    class="m-auto w-[min(95dvw,38rem)] rounded-xl border border-border bg-surface-card p-6 text-ink shadow-xl"
  >
    <div class="flex items-start justify-between gap-4">
      <h1 id="order-form-title" class="text-lg font-bold text-ink">
        {es.orders.modalCreateTitle}
      </h1>
      <form method="dialog">
        <button
          type="submit"
          value="close"
          class="rounded-md px-2.5 py-1 text-sm font-medium text-ink-muted hover:bg-surface hover:text-ink"
        >
          {es.orders.closeButton}
        </button>
      </form>
    </div>

    <form id="order-form" novalidate class="mt-4 space-y-4">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="flex flex-col gap-1.5">
          <label for="order-table" class="text-sm font-medium text-ink">
            {es.orders.tableLabel}
          </label>
          <select
            id="order-table"
            name="table_id"
            required
            autofocus
            aria-describedby="order-form-error"
            class="min-h-11 rounded-lg border border-border bg-white px-3 py-2 text-sm text-ink"
          >
            <option value="">{es.orders.selectTablePlaceholder}</option>
            {tables.map((t) => (
              <option value={String(t.id)} data-table-status={t.status}>
                #{t.number} {t.label ? `(${t.label})` : ''} —{' '}
                {es.tables.statusLabels[t.status]}
              </option>
            ))}
          </select>
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="order-waiter" class="text-sm font-medium text-ink">
            {es.orders.waiterLabel}
          </label>
          <select
            id="order-waiter"
            name="waiter_id"
            required
            aria-describedby="order-form-error"
            class="min-h-11 rounded-lg border border-border bg-white px-3 py-2 text-sm text-ink"
          >
            <option value="">{es.orders.selectWaiterPlaceholder}</option>
            {waiters.map((w) => (
              <option value={String(w.id)}>{w.name}</option>
            ))}
          </select>
        </div>
      </div>

      <fieldset class="space-y-3 rounded-lg border border-border p-3">
        <legend class="px-1 text-sm font-semibold text-ink">
          {es.orders.cartHeading}
        </legend>

        <div class="flex flex-wrap items-end gap-2">
          <div class="flex min-w-44 flex-1 flex-col gap-1">
            <label
              for="order-product-picker"
              class="text-xs font-medium text-ink-muted"
            >
              {es.orders.addProductLabel}
            </label>
            <select
              id="order-product-picker"
              class="min-h-10 rounded-lg border border-border bg-white px-3 py-2 text-sm text-ink"
            >
              <option value="">{es.orders.selectProductPlaceholder}</option>
              {products.map((p) => (
                <option
                  value={String(p.id)}
                  data-product-name={p.name}
                  data-price-cents={String(p.price_cents)}
                >
                  {p.name} ({formatPriceFromCents(p.price_cents)})
                </option>
              ))}
            </select>
          </div>

          <div class="flex w-24 flex-col gap-1">
            <label
              for="order-item-quantity"
              class="text-xs font-medium text-ink-muted"
            >
              {es.orders.quantityLabel}
            </label>
            <input
              id="order-item-quantity"
              type="text"
              inputmode="numeric"
              value="1"
              class="min-h-10 rounded-lg border border-border bg-white px-3 py-2 text-sm text-ink"
            />
          </div>

          <button
            id="order-add-item-btn"
            type="button"
            class="inline-flex min-h-10 items-center rounded-lg border border-brand bg-brand-soft px-3 py-2 text-xs font-semibold text-brand-strong hover:bg-brand hover:text-white"
          >
            {es.orders.addItemButton}
          </button>
        </div>

        <p id="order-cart-empty" class="text-xs text-ink-muted">
          {es.orders.cartEmpty}
        </p>
        <ul id="order-cart-list" class="space-y-2"></ul>

        <div class="flex items-center justify-between border-t border-border pt-2 text-sm font-semibold text-ink">
          <span>{es.orders.subtotalLabel}</span>
          <span id="order-subtotal-display">$0</span>
        </div>
      </fieldset>

      <div class="flex flex-col gap-1.5">
        <label for="order-notes" class="text-sm font-medium text-ink">
          {es.orders.notesLabel}
        </label>
        <span id="order-notes-hint" class="text-xs text-ink-muted">
          {es.orders.notesHint}
        </span>
        <textarea
          id="order-notes"
          name="notes"
          rows="2"
          maxlength="500"
          aria-describedby="order-notes-hint"
          class="rounded-lg border border-border bg-white px-3 py-2 text-sm text-ink"
        ></textarea>
      </div>

      <p
        id="order-form-error"
        role="alert"
        hidden
        class="text-xs font-medium text-danger"
      ></p>

      <div class="flex items-center justify-end gap-2 pt-2">
        <button
          type="submit"
          formmethod="dialog"
          formnovalidate
          value="cancel"
          class="inline-flex min-h-10 items-center rounded-lg border border-border px-4 py-2 text-sm font-medium text-ink-muted hover:bg-surface hover:text-ink"
        >
          {es.orders.cancelButton}
        </button>
        <button
          id="order-submit-btn"
          type="submit"
          class="inline-flex min-h-10 items-center rounded-lg bg-brand px-4 py-2 text-sm font-semibold text-white hover:bg-brand-strong disabled:opacity-60"
        >
          {es.orders.saveButton}
        </button>
      </div>
    </form>
  </dialog>

  <dialog
    id="order-checkout-dialog"
    closedby="any"
    aria-labelledby="order-checkout-title"
    class="m-auto w-[min(92dvw,28rem)] rounded-xl border border-border bg-surface-card p-6 text-ink shadow-xl"
  >
    <div class="flex items-start justify-between gap-4">
      <h1 id="order-checkout-title" class="text-lg font-bold text-ink">
        {es.orders.checkoutTitle}
      </h1>
      <form method="dialog">
        <button
          type="submit"
          value="close"
          class="rounded-md px-2.5 py-1 text-sm font-medium text-ink-muted hover:bg-surface hover:text-ink"
        >
          {es.orders.closeButton}
        </button>
      </form>
    </div>

    <form id="order-checkout-form" novalidate class="mt-4 space-y-4">
      <div class="flex flex-col gap-1.5">
        <label for="checkout-tip-percent" class="text-sm font-medium text-ink">
          {es.orders.checkoutTipLabel}
        </label>
        <span id="checkout-tip-hint" class="text-xs text-ink-muted">
          {es.orders.checkoutTipHint}
        </span>
        <input
          id="checkout-tip-percent"
          name="tip_percent"
          type="text"
          inputmode="numeric"
          value="10"
          autofocus
          aria-describedby="checkout-tip-hint order-checkout-error"
          class="min-h-11 rounded-lg border border-border bg-white px-3 py-2 text-sm text-ink"
        />
      </div>

      <dl class="space-y-1.5 rounded-lg border border-border bg-surface p-3 text-sm">
        <div class="flex items-center justify-between">
          <dt class="text-ink-muted">{es.orders.checkoutSubtotalLabel}</dt>
          <dd id="checkout-subtotal" class="font-medium text-ink">
            $0
          </dd>
        </div>
        <div class="flex items-center justify-between">
          <dt class="text-ink-muted">{es.orders.checkoutTipAmountLabel}</dt>
          <dd id="checkout-tip-amount" class="font-medium text-ink">
            $0
          </dd>
        </div>
        <div class="flex items-center justify-between border-t border-border pt-1.5 text-base font-bold">
          <dt class="text-ink">{es.orders.checkoutTotalLabel}</dt>
          <dd id="checkout-total" class="text-brand-strong">
            $0
          </dd>
        </div>
      </dl>

      <p
        id="order-checkout-error"
        role="alert"
        hidden
        class="text-xs font-medium text-danger"
      ></p>

      <div class="flex items-center justify-end gap-2 pt-2">
        <button
          type="submit"
          formmethod="dialog"
          formnovalidate
          value="cancel"
          class="inline-flex min-h-10 items-center rounded-lg border border-border px-4 py-2 text-sm font-medium text-ink-muted hover:bg-surface hover:text-ink"
        >
          {es.orders.cancelButton}
        </button>
        <button
          id="order-checkout-submit-btn"
          type="submit"
          class="inline-flex min-h-10 items-center rounded-lg bg-success px-4 py-2 text-sm font-semibold text-white hover:opacity-90 disabled:opacity-60"
        >
          {es.orders.checkoutConfirmButton}
        </button>
      </div>
    </form>
  </dialog>

  <dialog
    id="order-delete-dialog"
    closedby="any"
    aria-labelledby="order-delete-title"
    class="m-auto w-[min(92dvw,28rem)] rounded-xl border border-border bg-surface-card p-6 text-ink shadow-xl"
  >
    <h1 id="order-delete-title" class="text-lg font-bold text-ink">
      {es.orders.deleteTitle}
    </h1>
    <p id="order-delete-warning" class="mt-2 text-sm text-ink-muted"></p>
    <p
      id="order-delete-error"
      role="alert"
      hidden
      class="mt-3 text-xs font-medium text-danger"
    ></p>

    <div class="mt-6 flex items-center justify-end gap-2">
      <form method="dialog">
        <button
          type="submit"
          value="cancel"
          autofocus
          class="inline-flex min-h-10 items-center rounded-lg border border-border px-4 py-2 text-sm font-medium text-ink hover:bg-surface"
        >
          {es.orders.cancelButton}
        </button>
      </form>
      <button
        id="order-confirm-delete-btn"
        type="button"
        class="inline-flex min-h-10 items-center rounded-lg bg-danger px-4 py-2 text-sm font-semibold text-white hover:opacity-90 disabled:opacity-60"
      >
        {es.orders.confirmDeleteButton}
      </button>
    </div>
  </dialog>
</section>

<script>
  import { initOrdersManager } from './ordersClient';

  initOrdersManager();
</script>
