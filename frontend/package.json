{
  "name": "gardylafquen-frontend",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4321",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0 --port 4321",
    "check": "astro check",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{astro,ts,tsx,css,json}\"",
    "format": "prettier --write \"src/**/*.{astro,ts,tsx,css,json}\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.14",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.6.7",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
