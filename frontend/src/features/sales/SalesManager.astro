---
import { formatPriceFromCents } from '../../lib/format/currency';
import { es } from '../../lib/i18n/es';
import type { PaginatedResponse } from '../../types/api';
import type { Sale, SalesSummary } from '../../types/sale';

interface Props {
  result: PaginatedResponse<Sale> | null;
  summary: SalesSummary | null;
  fromDate: string;
  toDate: string;
  loadFailed: boolean;
}

const { result, summary, fromDate, toDate, loadFailed } = Astro.props;
const sales = result?.data ?? [];
const meta = result?.meta;
const hasDateFilter = fromDate !== '' || toDate !== '';

const buildPageHref = (page: number): string => {
  const params = new URLSearchParams();
  if (fromDate !== '') {
    params.set('from', fromDate);
  }
  if (toDate !== '') {
    params.set('to', toDate);
  }
  params.set('page', String(page));
  return `/sales?${params.toString()}`;
};

const formatDateTime = (iso: string): string => {
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) {
    return iso;
  }
  return new Intl.DateTimeFormat('es-CL', {
    dateStyle: 'medium',
    timeStyle: 'short',
  }).format(date);
};
---

<section class="space-y-6">
  <div class="space-y-1">
    <h1 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
      {es.sales.heading}
    </h1>
    <p class="text-sm text-ink-muted sm:text-base">{es.sales.subtitle}</p>
  </div>

  <search>
    <form
      action="/sales"
      method="GET"
      class="flex flex-wrap items-end gap-3 rounded-xl border border-border bg-surface-card p-4 shadow-xs"
    >
      <div class="flex min-w-44 flex-1 flex-col gap-1.5">
        <label for="sales-from" class="text-sm font-medium text-ink">
          {es.sales.fromLabel}
        </label>
        <input
          id="sales-from"
          type="date"
          name="from"
          value={fromDate}
          class="min-h-11 rounded-lg border border-border bg-white px-3 py-2 text-sm text-ink"
        />
      </div>

      <div class="flex min-w-44 flex-1 flex-col gap-1.5">
        <label for="sales-to" class="text-sm font-medium text-ink">
          {es.sales.toLabel}
        </label>
        <input
          id="sales-to"
          type="date"
          name="to"
          value={toDate}
          class="min-h-11 rounded-lg border border-border bg-white px-3 py-2 text-sm text-ink"
        />
      </div>

      <div class="flex items-center gap-2">
        <button
          type="submit"
          class="inline-flex min-h-11 items-center rounded-lg border border-brand bg-brand-soft px-4 py-2 text-sm font-semibold text-brand-strong transition-colors hover:bg-brand hover:text-white"
        >
          {es.sales.filterButton}
        </button>

        {hasDateFilter && (
          <a
            href="/sales"
            class="inline-flex min-h-11 items-center rounded-lg border border-border px-4 py-2 text-sm font-medium text-ink-muted hover:bg-surface hover:text-ink"
          >
            {es.sales.clearFilter}
          </a>
        )}
      </div>
    </form>
  </search>

  {summary !== null && (
    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-xl border border-border bg-surface-card p-4 shadow-xs">
        <dt class="text-xs font-medium text-ink-muted">
          {es.sales.summaryCount}
        </dt>
        <dd class="mt-1 text-2xl font-bold text-ink">{summary.count}</dd>
      </div>
      <div class="rounded-xl border border-border bg-surface-card p-4 shadow-xs">
        <dt class="text-xs font-medium text-ink-muted">
          {es.sales.summarySubtotal}
        </dt>
        <dd class="mt-1 text-2xl font-bold text-ink">
          {formatPriceFromCents(summary.subtotal_cents)}
        </dd>
      </div>
      <div class="rounded-xl border border-border bg-surface-card p-4 shadow-xs">
        <dt class="text-xs font-medium text-ink-muted">
          {es.sales.summaryTip}
        </dt>
        <dd class="mt-1 text-2xl font-bold text-ink">
          {formatPriceFromCents(summary.tip_cents)}
        </dd>
      </div>
      <div class="rounded-xl border border-brand/30 bg-brand-soft/60 p-4 shadow-xs">
        <dt class="text-xs font-medium text-brand-strong">
          {es.sales.summaryTotal}
        </dt>
        <dd class="mt-1 text-2xl font-bold text-brand-strong">
          {formatPriceFromCents(summary.total_cents)}
        </dd>
      </div>
    </dl>
  )}

  {loadFailed && (
    <div
      role="alert"
      class="rounded-xl border border-danger/30 bg-danger-soft p-4 text-sm font-medium text-danger"
    >
      {es.sales.loadError}
    </div>
  )}

  <div class="overflow-hidden rounded-xl border border-border bg-surface-card shadow-xs">
    {sales.length === 0 ? (
      <p class="p-8 text-center text-sm text-ink-muted">
        {hasDateFilter ? es.sales.emptyFiltered : es.sales.emptyTitle}
      </p>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left text-sm">
          <caption class="sr-only">{es.sales.tableCaption}</caption>
          <thead class="border-b border-border bg-surface text-xs font-semibold uppercase tracking-wide text-ink-muted">
            <tr>
              <th scope="col" class="px-4 py-3">
                {es.sales.colTicket}
              </th>
              <th scope="col" class="px-4 py-3">
                {es.sales.colOrder}
              </th>
              <th scope="col" class="px-4 py-3">
                {es.sales.colTable}
              </th>
              <th scope="col" class="px-4 py-3">
                {es.sales.colWaiter}
              </th>
              <th scope="col" class="px-4 py-3">
                {es.sales.colSubtotal}
              </th>
              <th scope="col" class="px-4 py-3">
                {es.sales.colTip}
              </th>
              <th scope="col" class="px-4 py-3">
                {es.sales.colTotal}
              </th>
              <th scope="col" class="px-4 py-3">
                {es.sales.colPaidAt}
              </th>
              <th scope="col" class="px-4 py-3 text-right">
                {es.sales.colActions}
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border/70">
            {sales.map((sale) => {
              const tableLabel = sale.order?.table
                ? `#${sale.order.table.number}`
                : sale.order
                  ? `#${sale.order.table_id}`
                  : '—';
              const waiterName = sale.order?.waiter?.name ?? '—';
              const formattedDate = formatDateTime(sale.paid_at);

              return (
                <tr class="hover:bg-surface/60">
                  <td class="px-4 py-3 font-semibold text-ink">#{sale.id}</td>
                  <td class="px-4 py-3 text-ink-muted">#{sale.order_id}</td>
                  <td class="px-4 py-3 text-ink">{tableLabel}</td>
                  <td class="px-4 py-3 text-ink-muted">{waiterName}</td>
                  <td class="px-4 py-3 text-ink">
                    {formatPriceFromCents(sale.subtotal_cents)}
                  </td>
                  <td class="px-4 py-3 text-ink-muted">
                    {formatPriceFromCents(sale.tip_cents)} ({sale.tip_percent}%)
                  </td>
                  <td class="px-4 py-3 font-semibold text-brand-strong">
                    {formatPriceFromCents(sale.total_cents)}
                  </td>
                  <td class="px-4 py-3 text-ink-muted">{formattedDate}</td>
                  <td class="px-4 py-3 text-right">
                    <button
                      type="button"
                      data-action="view-receipt"
                      data-sale-id={String(sale.id)}
                      data-sale-order-id={String(sale.order_id)}
                      data-sale-table={tableLabel}
                      data-sale-waiter={waiterName}
                      data-sale-paid-at={formattedDate}
                      data-sale-subtotal={String(sale.subtotal_cents)}
                      data-sale-tip={String(sale.tip_cents)}
                      data-sale-tip-percent={String(sale.tip_percent)}
                      data-sale-total={String(sale.total_cents)}
                      data-sale-items={JSON.stringify(sale.order?.items ?? [])}
                      aria-label={`${es.sales.viewReceiptButton} #${sale.id}`}
                      class="inline-flex min-h-9 items-center rounded-md border border-border px-3 py-1.5 text-xs font-semibold text-ink hover:bg-surface"
                    >
                      {es.sales.viewReceiptButton}
                    </button>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </div>

  {meta !== undefined && meta.last_page > 1 && (
    <nav
      aria-label={es.sales.tableCaption}
      class="flex flex-wrap items-center justify-between gap-4 text-sm"
    >
      <p class="text-ink-muted">
        {es.sales.paginationSummary(
          meta.current_page,
          meta.last_page,
          meta.total,
        )}
      </p>

      <div class="flex items-center gap-2">
        {meta.current_page > 1 && (
          <a
            href={buildPageHref(meta.current_page - 1)}
            class="inline-flex min-h-10 items-center rounded-lg border border-border bg-surface-card px-3 py-2 font-medium text-ink hover:bg-surface"
          >
            {es.sales.paginationPrev}
          </a>
        )}
        {meta.current_page < meta.last_page && (
          <a
            href={buildPageHref(meta.current_page + 1)}
            class="inline-flex min-h-10 items-center rounded-lg border border-border bg-surface-card px-3 py-2 font-medium text-ink hover:bg-surface"
          >
            {es.sales.paginationNext}
          </a>
        )}
      </div>
    </nav>
  )}

  <dialog
    id="sale-receipt-dialog"
    closedby="any"
    aria-labelledby="sale-receipt-title"
    class="m-auto w-[min(92dvw,30rem)] rounded-xl border border-border bg-surface-card p-6 text-ink shadow-xl"
  >
    <div class="flex items-start justify-between gap-4">
      <h1 id="sale-receipt-title" class="text-lg font-bold text-ink"></h1>
      <form method="dialog">
        <button
          type="submit"
          value="close"
          autofocus
          class="rounded-md px-2.5 py-1 text-sm font-medium text-ink-muted hover:bg-surface hover:text-ink"
        >
          {es.sales.closeButton}
        </button>
      </form>
    </div>

    <p id="sale-receipt-meta" class="mt-1 text-xs text-ink-muted"></p>

    <ul
      id="sale-receipt-items"
      class="mt-4 divide-y divide-border/70 border-y border-border py-2"
    ></ul>

    <dl class="mt-4 space-y-1.5 text-sm">
      <div class="flex items-center justify-between">
        <dt class="text-ink-muted">{es.sales.colSubtotal}</dt>
        <dd id="sale-receipt-subtotal" class="font-medium text-ink"></dd>
      </div>
      <div class="flex items-center justify-between">
        <dt class="text-ink-muted">{es.sales.colTip}</dt>
        <dd id="sale-receipt-tip" class="font-medium text-ink"></dd>
      </div>
      <div class="flex items-center justify-between border-t border-border pt-2 text-base font-bold">
        <dt class="text-ink">{es.sales.colTotal}</dt>
        <dd id="sale-receipt-total" class="text-brand-strong"></dd>
      </div>
    </dl>

    <div class="mt-6 flex justify-end">
      <button
        id="sale-receipt-print-btn"
        type="button"
        class="inline-flex min-h-10 items-center rounded-lg bg-brand px-4 py-2 text-sm font-semibold text-white hover:bg-brand-strong"
      >
        {es.sales.receiptPrintButton}
      </button>
    </div>
  </dialog>
</section>

<script>
  import { initSalesManager } from './salesClient';

  initSalesManager();
</script>
