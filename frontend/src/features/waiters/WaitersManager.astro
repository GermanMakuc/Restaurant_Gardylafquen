---
import { es } from '../../lib/i18n/es';
import type { PaginatedResponse } from '../../types/api';
import type { Waiter } from '../../types/waiter';

interface Props {
  result: PaginatedResponse<Waiter> | null;
  searchQuery: string;
  activeFilter: string;
  loadFailed: boolean;
}

const { result, searchQuery, activeFilter, loadFailed } = Astro.props;
const waiters = result?.data ?? [];
const meta = result?.meta;
const hasActiveFilters = searchQuery.trim() !== '' || activeFilter !== '';

const buildPageHref = (page: number): string => {
  const params = new URLSearchParams();
  if (searchQuery.trim() !== '') {
    params.set('q', searchQuery.trim());
  }
  if (activeFilter !== '') {
    params.set('active', activeFilter);
  }
  params.set('page', String(page));
  return `/waiters?${params.toString()}`;
};
---

<section class="space-y-6">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="space-y-1">
      <h1 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
        {es.waiters.heading}
      </h1>
      <p class="text-sm text-ink-muted sm:text-base">{es.waiters.subtitle}</p>
    </div>

    <button
      id="open-create-waiter"
      type="button"
      class="inline-flex min-h-11 items-center rounded-lg bg-brand px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-strong"
    >
      {es.waiters.addButton}
    </button>
  </div>

  <search>
    <form
      action="/waiters"
      method="GET"
      class="flex flex-wrap items-end gap-3 rounded-xl border border-border bg-surface-card p-4 shadow-xs"
    >
      <div class="flex min-w-52 flex-1 flex-col gap-1.5">
        <label for="waiter-search" class="text-sm font-medium text-ink">
          {es.waiters.searchLabel}
        </label>
        <input
          id="waiter-search"
          type="search"
          name="q"
          value={searchQuery}
          placeholder={es.waiters.searchPlaceholder}
          class="min-h-11 rounded-lg border border-border bg-white px-3 py-2 text-sm text-ink"
        />
      </div>

      <div class="flex min-w-40 flex-col gap-1.5">
        <label for="waiter-active-filter" class="text-sm font-medium text-ink">
          {es.waiters.statusFilterLabel}
        </label>
        <select
          id="waiter-active-filter"
          name="active"
          class="min-h-11 rounded-lg border border-border bg-white px-3 py-2 text-sm text-ink"
        >
          <option value="">{es.waiters.allStatuses}</option>
          <option value="true" selected={activeFilter === 'true'}>
            {es.waiters.onlyActive}
          </option>
          <option value="false" selected={activeFilter === 'false'}>
            {es.waiters.onlyInactive}
          </option>
        </select>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="submit"
          class="inline-flex min-h-11 items-center rounded-lg border border-brand bg-brand-soft px-4 py-2 text-sm font-semibold text-brand-strong transition-colors hover:bg-brand hover:text-white"
        >
          {es.waiters.searchButton}
        </button>

        {hasActiveFilters && (
          <a
            href="/waiters"
            class="inline-flex min-h-11 items-center rounded-lg border border-border px-4 py-2 text-sm font-medium text-ink-muted hover:bg-surface hover:text-ink"
          >
            {es.waiters.clearSearch}
          </a>
        )}
      </div>
    </form>
  </search>

  {loadFailed && (
    <div
      role="alert"
      class="rounded-xl border border-danger/30 bg-danger-soft p-4 text-sm font-medium text-danger"
    >
      {es.waiters.loadError}
    </div>
  )}

  <div class="overflow-hidden rounded-xl border border-border bg-surface-card shadow-xs">
    {waiters.length === 0 ? (
      <p class="p-8 text-center text-sm text-ink-muted">
        {hasActiveFilters ? es.waiters.emptyFiltered : es.waiters.emptyTitle}
      </p>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left text-sm">
          <caption class="sr-only">{es.waiters.tableCaption}</caption>
          <thead class="border-b border-border bg-surface text-xs font-semibold uppercase tracking-wide text-ink-muted">
            <tr>
              <th scope="col" class="px-4 py-3">
                {es.waiters.colName}
              </th>
              <th scope="col" class="px-4 py-3">
                {es.waiters.colEmail}
              </th>
              <th scope="col" class="px-4 py-3">
                {es.waiters.colStatus}
              </th>
              <th scope="col" class="px-4 py-3 text-right">
                {es.waiters.colActions}
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border/70">
            {waiters.map((waiter) => (
              <tr class="hover:bg-surface/60">
                <td class="px-4 py-3 font-medium text-ink">{waiter.name}</td>
                <td class="px-4 py-3 text-ink-muted">{waiter.email}</td>
                <td class="px-4 py-3">
                  <span
                    class:list={[
                      'inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-semibold',
                      waiter.is_active
                        ? 'border-success/30 bg-success-soft text-success'
                        : 'border-border bg-surface text-ink-muted',
                    ]}
                  >
                    <span
                      aria-hidden="true"
                      class:list={[
                        'inline-block size-1.5 rounded-full',
                        waiter.is_active ? 'bg-success' : 'bg-ink-muted',
                      ]}
                    />
                    <span>
                      {waiter.is_active
                        ? es.waiters.statusActive
                        : es.waiters.statusInactive}
                    </span>
                  </span>
                </td>
                <td class="px-4 py-3 text-right">
                  <div class="inline-flex items-center justify-end gap-2">
                    <button
                      type="button"
                      data-action="edit-waiter"
                      data-waiter-id={String(waiter.id)}
                      data-waiter-name={waiter.name}
                      data-waiter-email={waiter.email}
                      data-waiter-active={String(waiter.is_active)}
                      aria-label={`${es.waiters.editButton} ${waiter.name}`}
                      class="inline-flex min-h-9 items-center rounded-md border border-border px-3 py-1.5 text-xs font-semibold text-ink hover:bg-surface"
                    >
                      {es.waiters.editButton}
                    </button>
                    <button
                      type="button"
                      data-action="delete-waiter"
                      data-waiter-id={String(waiter.id)}
                      data-waiter-name={waiter.name}
                      aria-label={`${es.waiters.deleteButton} ${waiter.name}`}
                      class="inline-flex min-h-9 items-center rounded-md border border-danger/30 bg-danger-soft px-3 py-1.5 text-xs font-semibold text-danger hover:bg-danger hover:text-white"
                    >
                      {es.waiters.deleteButton}
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>

  {meta !== undefined && meta.last_page > 1 && (
    <nav
      aria-label={es.waiters.tableCaption}
      class="flex flex-wrap items-center justify-between gap-4 text-sm"
    >
      <p class="text-ink-muted">
        {es.waiters.paginationSummary(
          meta.current_page,
          meta.last_page,
          meta.total,
        )}
      </p>

      <div class="flex items-center gap-2">
        {meta.current_page > 1 && (
          <a
            href={buildPageHref(meta.current_page - 1)}
            class="inline-flex min-h-10 items-center rounded-lg border border-border bg-surface-card px-3 py-2 font-medium text-ink hover:bg-surface"
          >
            {es.waiters.paginationPrev}
          </a>
        )}
        {meta.current_page < meta.last_page && (
          <a
            href={buildPageHref(meta.current_page + 1)}
            class="inline-flex min-h-10 items-center rounded-lg border border-border bg-surface-card px-3 py-2 font-medium text-ink hover:bg-surface"
          >
            {es.waiters.paginationNext}
          </a>
        )}
      </div>
    </nav>
  )}

  <dialog
    id="waiter-form-dialog"
    closedby="any"
    aria-labelledby="waiter-form-title"
    class="m-auto w-[min(92dvw,28rem)] rounded-xl border border-border bg-surface-card p-6 text-ink shadow-xl"
  >
    <div class="flex items-start justify-between gap-4">
      <h1 id="waiter-form-title" class="text-lg font-bold text-ink">
        {es.waiters.modalCreateTitle}
      </h1>
      <form method="dialog">
        <button
          type="submit"
          value="close"
          class="rounded-md px-2.5 py-1 text-sm font-medium text-ink-muted hover:bg-surface hover:text-ink"
        >
          {es.waiters.closeButton}
        </button>
      </form>
    </div>

    <form id="waiter-form" novalidate class="mt-4 space-y-4">
      <div class="flex flex-col gap-1.5">
        <label for="waiter-name" class="text-sm font-medium text-ink">
          {es.waiters.nameLabel}
        </label>
        <span id="waiter-name-hint" class="text-xs text-ink-muted">
          {es.waiters.nameHint}
        </span>
        <input
          id="waiter-name"
          name="name"
          type="text"
          autocomplete="name"
          required
          minlength="2"
          maxlength="150"
          autofocus
          aria-describedby="waiter-name-hint waiter-form-error"
          class="min-h-11 rounded-lg border border-border bg-white px-3 py-2 text-sm text-ink"
        />
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="waiter-email" class="text-sm font-medium text-ink">
          {es.waiters.emailLabel}
        </label>
        <span id="waiter-email-hint" class="text-xs text-ink-muted">
          {es.waiters.emailHint}
        </span>
        <input
          id="waiter-email"
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="none"
          spellcheck="false"
          required
          maxlength="255"
          aria-describedby="waiter-email-hint waiter-form-error"
          class="min-h-11 rounded-lg border border-border bg-white px-3 py-2 text-sm text-ink"
        />
      </div>

      <div class="flex items-center gap-2.5">
        <input
          id="waiter-active"
          name="is_active"
          type="checkbox"
          checked
          class="size-4 accent-brand"
        />
        <label for="waiter-active" class="text-sm font-medium text-ink">
          {es.waiters.activeLabel}
        </label>
      </div>

      <p
        id="waiter-form-error"
        role="alert"
        hidden
        class="text-xs font-medium text-danger"
      ></p>

      <div class="flex items-center justify-end gap-2 pt-2">
        <button
          type="submit"
          formmethod="dialog"
          formnovalidate
          value="cancel"
          class="inline-flex min-h-10 items-center rounded-lg border border-border px-4 py-2 text-sm font-medium text-ink-muted hover:bg-surface hover:text-ink"
        >
          {es.waiters.cancelButton}
        </button>
        <button
          id="waiter-submit-btn"
          type="submit"
          class="inline-flex min-h-10 items-center rounded-lg bg-brand px-4 py-2 text-sm font-semibold text-white hover:bg-brand-strong disabled:opacity-60"
        >
          {es.waiters.saveButton}
        </button>
      </div>
    </form>
  </dialog>

  <dialog
    id="waiter-delete-dialog"
    closedby="any"
    aria-labelledby="waiter-delete-title"
    class="m-auto w-[min(92dvw,28rem)] rounded-xl border border-border bg-surface-card p-6 text-ink shadow-xl"
  >
    <h1 id="waiter-delete-title" class="text-lg font-bold text-ink">
      {es.waiters.deleteTitle}
    </h1>
    <p id="waiter-delete-warning" class="mt-2 text-sm text-ink-muted"></p>
    <p
      id="waiter-delete-error"
      role="alert"
      hidden
      class="mt-3 text-xs font-medium text-danger"
    ></p>

    <div class="mt-6 flex items-center justify-end gap-2">
      <form method="dialog">
        <button
          type="submit"
          value="cancel"
          autofocus
          class="inline-flex min-h-10 items-center rounded-lg border border-border px-4 py-2 text-sm font-medium text-ink hover:bg-surface"
        >
          {es.waiters.cancelButton}
        </button>
      </form>
      <button
        id="waiter-confirm-delete-btn"
        type="button"
        class="inline-flex min-h-10 items-center rounded-lg bg-danger px-4 py-2 text-sm font-semibold text-white hover:opacity-90 disabled:opacity-60"
      >
        {es.waiters.confirmDeleteButton}
      </button>
    </div>
  </dialog>
</section>

<script>
  import { initWaitersManager } from './waitersClient';

  initWaitersManager();
</script>
