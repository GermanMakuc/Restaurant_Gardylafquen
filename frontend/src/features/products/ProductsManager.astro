---
import { formatPriceFromCents } from '../../lib/format/currency';
import { es } from '../../lib/i18n/es';
import type { PaginatedResponse } from '../../types/api';
import type { Category } from '../../types/category';
import type { Product } from '../../types/product';

interface Props {
  result: PaginatedResponse<Product> | null;
  categories: Category[];
  searchQuery: string;
  selectedCategoryId: number | null;
  loadFailed: boolean;
}

const { result, categories, searchQuery, selectedCategoryId, loadFailed } =
  Astro.props;
const products = result?.data ?? [];
const meta = result?.meta;
const hasActiveFilters =
  searchQuery.trim() !== '' || selectedCategoryId !== null;

const buildPageHref = (page: number): string => {
  const params = new URLSearchParams();
  if (searchQuery.trim() !== '') {
    params.set('q', searchQuery.trim());
  }
  if (selectedCategoryId !== null) {
    params.set('category', String(selectedCategoryId));
  }
  params.set('page', String(page));
  return `/products?${params.toString()}`;
};
---

<section class="space-y-6">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="space-y-1">
      <h1 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
        {es.products.heading}
      </h1>
      <p class="text-sm text-ink-muted sm:text-base">{es.products.subtitle}</p>
    </div>

    <button
      id="open-create-product"
      type="button"
      class="inline-flex min-h-11 items-center rounded-lg bg-brand px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-strong"
    >
      {es.products.addButton}
    </button>
  </div>

  <search>
    <form
      action="/products"
      method="GET"
      class="flex flex-wrap items-end gap-3 rounded-xl border border-border bg-surface-card p-4 shadow-xs"
    >
      <div class="flex min-w-52 flex-1 flex-col gap-1.5">
        <label for="product-search" class="text-sm font-medium text-ink">
          {es.products.searchLabel}
        </label>
        <input
          id="product-search"
          type="search"
          name="q"
          value={searchQuery}
          placeholder={es.products.searchPlaceholder}
          class="min-h-11 rounded-lg border border-border bg-white px-3 py-2 text-sm text-ink"
        />
      </div>

      <div class="flex min-w-48 flex-col gap-1.5">
        <label
          for="product-category-filter"
          class="text-sm font-medium text-ink"
        >
          {es.products.categoryFilterLabel}
        </label>
        <select
          id="product-category-filter"
          name="category"
          class="min-h-11 rounded-lg border border-border bg-white px-3 py-2 text-sm text-ink"
        >
          <option value="">{es.products.allCategories}</option>
          {categories.map((cat) => (
            <option
              value={String(cat.id)}
              selected={selectedCategoryId === cat.id}
            >
              {cat.name}
            </option>
          ))}
        </select>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="submit"
          class="inline-flex min-h-11 items-center rounded-lg border border-brand bg-brand-soft px-4 py-2 text-sm font-semibold text-brand-strong transition-colors hover:bg-brand hover:text-white"
        >
          {es.products.searchButton}
        </button>

        {hasActiveFilters && (
          <a
            href="/products"
            class="inline-flex min-h-11 items-center rounded-lg border border-border px-4 py-2 text-sm font-medium text-ink-muted hover:bg-surface hover:text-ink"
          >
            {es.products.clearSearch}
          </a>
        )}
      </div>
    </form>
  </search>

  {loadFailed && (
    <div
      role="alert"
      class="rounded-xl border border-danger/30 bg-danger-soft p-4 text-sm font-medium text-danger"
    >
      {es.products.loadError}
    </div>
  )}

  <div class="overflow-hidden rounded-xl border border-border bg-surface-card shadow-xs">
    {products.length === 0 ? (
      <p class="p-8 text-center text-sm text-ink-muted">
        {hasActiveFilters ? es.products.emptyFiltered : es.products.emptyTitle}
      </p>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left text-sm">
          <caption class="sr-only">{es.products.tableCaption}</caption>
          <thead class="border-b border-border bg-surface text-xs font-semibold uppercase tracking-wide text-ink-muted">
            <tr>
              <th scope="col" class="px-4 py-3">
                {es.products.colProduct}
              </th>
              <th scope="col" class="px-4 py-3">
                {es.products.colCategory}
              </th>
              <th scope="col" class="px-4 py-3">
                {es.products.colPrice}
              </th>
              <th scope="col" class="px-4 py-3 text-right">
                {es.products.colActions}
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border/70">
            {products.map((product) => (
              <tr class="hover:bg-surface/60">
                <td class="px-4 py-3">
                  <div class="flex items-center gap-3">
                    {product.image_url !== null ? (
                      <img
                        src={product.image_url}
                        alt={product.name}
                        width="48"
                        height="48"
                        loading="lazy"
                        class="size-12 shrink-0 rounded-lg border border-border object-cover"
                      />
                    ) : (
                      <div
                        aria-hidden="true"
                        class="flex size-12 shrink-0 items-center justify-center rounded-lg border border-border bg-surface text-xs font-semibold text-ink-muted"
                      >
                        —
                      </div>
                    )}
                    <div>
                      <p class="font-medium text-ink">{product.name}</p>
                      {product.description !== null && (
                        <p class="mt-0.5 line-clamp-2 max-w-md text-xs text-ink-muted">
                          {product.description}
                        </p>
                      )}
                    </div>
                  </div>
                </td>
                <td class="px-4 py-3 text-ink-muted">
                  <span class="inline-flex rounded-md bg-surface px-2.5 py-1 text-xs font-medium text-ink">
                    {product.category?.name ?? es.products.noCategory}
                  </span>
                </td>
                <td class="px-4 py-3 font-semibold text-ink">
                  {formatPriceFromCents(product.price_cents)}
                </td>
                <td class="px-4 py-3 text-right">
                  <div class="inline-flex items-center justify-end gap-2">
                    <button
                      type="button"
                      data-action="edit-product"
                      data-product-id={String(product.id)}
                      data-product-name={product.name}
                      data-product-category-id={String(product.category_id)}
                      data-product-price-cents={String(product.price_cents)}
                      data-product-description={product.description ?? ''}
                      aria-label={`${es.products.editButton} ${product.name}`}
                      class="inline-flex min-h-9 items-center rounded-md border border-border px-3 py-1.5 text-xs font-semibold text-ink hover:bg-surface"
                    >
                      {es.products.editButton}
                    </button>
                    <button
                      type="button"
                      data-action="delete-product"
                      data-product-id={String(product.id)}
                      data-product-name={product.name}
                      aria-label={`${es.products.deleteButton} ${product.name}`}
                      class="inline-flex min-h-9 items-center rounded-md border border-danger/30 bg-danger-soft px-3 py-1.5 text-xs font-semibold text-danger hover:bg-danger hover:text-white"
                    >
                      {es.products.deleteButton}
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>

  {meta !== undefined && meta.last_page > 1 && (
    <nav
      aria-label={es.products.tableCaption}
      class="flex flex-wrap items-center justify-between gap-4 text-sm"
    >
      <p class="text-ink-muted">
        {es.products.paginationSummary(
          meta.current_page,
          meta.last_page,
          meta.total,
        )}
      </p>

      <div class="flex items-center gap-2">
        {meta.current_page > 1 && (
          <a
            href={buildPageHref(meta.current_page - 1)}
            class="inline-flex min-h-10 items-center rounded-lg border border-border bg-surface-card px-3 py-2 font-medium text-ink hover:bg-surface"
          >
            {es.products.paginationPrev}
          </a>
        )}
        {meta.current_page < meta.last_page && (
          <a
            href={buildPageHref(meta.current_page + 1)}
            class="inline-flex min-h-10 items-center rounded-lg border border-border bg-surface-card px-3 py-2 font-medium text-ink hover:bg-surface"
          >
            {es.products.paginationNext}
          </a>
        )}
      </div>
    </nav>
  )}

  <dialog
    id="product-form-dialog"
    closedby="any"
    aria-labelledby="product-form-title"
    class="m-auto w-[min(94dvw,32rem)] rounded-xl border border-border bg-surface-card p-6 text-ink shadow-xl"
  >
    <div class="flex items-start justify-between gap-4">
      <h1 id="product-form-title" class="text-lg font-bold text-ink">
        {es.products.modalCreateTitle}
      </h1>
      <form method="dialog">
        <button
          type="submit"
          value="close"
          class="rounded-md px-2.5 py-1 text-sm font-medium text-ink-muted hover:bg-surface hover:text-ink"
        >
          {es.products.closeButton}
        </button>
      </form>
    </div>

    <form id="product-form" novalidate class="mt-4 space-y-4">
      <div class="flex flex-col gap-1.5">
        <label for="product-name" class="text-sm font-medium text-ink">
          {es.products.nameLabel}
        </label>
        <span id="product-name-hint" class="text-xs text-ink-muted">
          {es.products.nameHint}
        </span>
        <input
          id="product-name"
          name="name"
          type="text"
          required
          minlength="2"
          maxlength="150"
          autofocus
          aria-describedby="product-name-hint product-form-error"
          class="min-h-11 rounded-lg border border-border bg-white px-3 py-2 text-sm text-ink"
        />
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="product-category" class="text-sm font-medium text-ink">
          {es.products.categoryLabel}
        </label>
        <select
          id="product-category"
          name="category_id"
          required
          aria-describedby="product-form-error"
          class="min-h-11 rounded-lg border border-border bg-white px-3 py-2 text-sm text-ink"
        >
          <option value="">{es.products.selectCategoryPlaceholder}</option>
          {categories.map((cat) => (
            <option value={String(cat.id)}>{cat.name}</option>
          ))}
        </select>
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="product-price" class="text-sm font-medium text-ink">
          {es.products.priceLabel}
        </label>
        <span id="product-price-hint" class="text-xs text-ink-muted">
          {es.products.priceHint}
        </span>
        <input
          id="product-price"
          name="price"
          type="text"
          inputmode="decimal"
          required
          aria-describedby="product-price-hint product-form-error"
          class="min-h-11 rounded-lg border border-border bg-white px-3 py-2 text-sm text-ink"
        />
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="product-description" class="text-sm font-medium text-ink">
          {es.products.descriptionLabel}
        </label>
        <span id="product-description-hint" class="text-xs text-ink-muted">
          {es.products.descriptionHint}
        </span>
        <textarea
          id="product-description"
          name="description"
          rows="3"
          maxlength="500"
          aria-describedby="product-description-hint"
          class="rounded-lg border border-border bg-white px-3 py-2 text-sm text-ink"
        ></textarea>
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="product-image" class="text-sm font-medium text-ink">
          {es.products.imageLabel}
        </label>
        <span id="product-image-hint" class="text-xs text-ink-muted">
          {es.products.imageHint}
        </span>
        <input
          id="product-image"
          name="image"
          type="file"
          accept="image/jpeg,image/png,image/webp"
          aria-describedby="product-image-hint"
          class="min-h-11 rounded-lg border border-border bg-white px-3 py-2 text-sm text-ink"
        />
      </div>

      <p
        id="product-form-error"
        role="alert"
        hidden
        class="text-xs font-medium text-danger"
      ></p>

      <div class="flex items-center justify-end gap-2 pt-2">
        <button
          type="submit"
          formmethod="dialog"
          formnovalidate
          value="cancel"
          class="inline-flex min-h-10 items-center rounded-lg border border-border px-4 py-2 text-sm font-medium text-ink-muted hover:bg-surface hover:text-ink"
        >
          {es.products.cancelButton}
        </button>
        <button
          id="product-submit-btn"
          type="submit"
          class="inline-flex min-h-10 items-center rounded-lg bg-brand px-4 py-2 text-sm font-semibold text-white hover:bg-brand-strong disabled:opacity-60"
        >
          {es.products.saveButton}
        </button>
      </div>
    </form>
  </dialog>

  <dialog
    id="product-delete-dialog"
    closedby="any"
    aria-labelledby="product-delete-title"
    class="m-auto w-[min(92dvw,28rem)] rounded-xl border border-border bg-surface-card p-6 text-ink shadow-xl"
  >
    <h1 id="product-delete-title" class="text-lg font-bold text-ink">
      {es.products.deleteTitle}
    </h1>
    <p id="product-delete-warning" class="mt-2 text-sm text-ink-muted"></p>
    <p
      id="product-delete-error"
      role="alert"
      hidden
      class="mt-3 text-xs font-medium text-danger"
    ></p>

    <div class="mt-6 flex items-center justify-end gap-2">
      <form method="dialog">
        <button
          type="submit"
          value="cancel"
          autofocus
          class="inline-flex min-h-10 items-center rounded-lg border border-border px-4 py-2 text-sm font-medium text-ink hover:bg-surface"
        >
          {es.products.cancelButton}
        </button>
      </form>
      <button
        id="product-confirm-delete-btn"
        type="button"
        class="inline-flex min-h-10 items-center rounded-lg bg-danger px-4 py-2 text-sm font-semibold text-white hover:opacity-90 disabled:opacity-60"
      >
        {es.products.confirmDeleteButton}
      </button>
    </div>
  </dialog>
</section>

<script>
  import { initProductsManager } from './productsClient';

  initProductsManager();
</script>
