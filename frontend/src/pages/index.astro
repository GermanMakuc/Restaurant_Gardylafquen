---
import HealthBadge from '../features/system/HealthBadge.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getHealthStatus } from '../lib/api/health';
import { resolveServerSession } from '../lib/auth/session';
import { es } from '../lib/i18n/es';
import type { HealthStatus } from '../types/api';

const session = await resolveServerSession(Astro.cookies);
if (session === null) {
  return Astro.redirect('/login');
}

let health: HealthStatus | null = null;

try {
  health = await getHealthStatus();
} catch {
  health = null;
}

const visibleModules = es.home.modules.filter(
  (mod) =>
    mod.href !== '/sales' ||
    session.user.role === 'admin' ||
    session.user.role === 'cashier',
);
---

<BaseLayout title={es.home.pageTitle} user={session.user}>
  <section class="space-y-8">
    <div class="space-y-2">
      <h1 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
        {es.home.heading}
      </h1>
      <p class="max-w-2xl text-sm text-ink-muted sm:text-base">
        {es.home.subtitle}
      </p>
    </div>

    <HealthBadge health={health} />

    <section aria-labelledby="modules-heading" class="space-y-4">
      <h2 id="modules-heading" class="text-base font-semibold text-ink">
        {es.home.modulesSectionTitle}
      </h2>

      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {visibleModules.map((mod) => {
          const href = 'href' in mod ? mod.href : undefined;
          return (
            <li class="flex flex-col justify-between rounded-xl border border-border bg-surface-card p-5 shadow-xs">
              <div>
                <h3 class="text-base font-semibold text-ink">
                  {href !== undefined ? (
                    <a
                      href={href}
                      class="text-brand-strong underline decoration-brand-strong/40 underline-offset-4 hover:decoration-brand-strong"
                    >
                      {mod.name}
                    </a>
                  ) : (
                    mod.name
                  )}
                </h3>
                <p class="mt-1 text-sm text-ink-muted">{mod.description}</p>
              </div>
              <p
                class:list={[
                  'mt-4 inline-flex w-fit rounded-md px-2.5 py-1 text-xs font-medium',
                  href !== undefined
                    ? 'bg-brand-soft text-brand-strong'
                    : 'bg-surface text-ink-muted',
                ]}
              >
                {href !== undefined
                  ? es.home.activeBadge
                  : es.home.pendingBadge}
              </p>
            </li>
          );
        })}
      </ul>
    </section>
  </section>
</BaseLayout>
