---
import Navbar from '../components/Navbar.astro';
import { es } from '../lib/i18n/es';
import type { AuthUser } from '../types/auth';
import '../styles/global.css';

interface Props {
  title: string;
  user?: AuthUser | null;
}

const { title, user = null } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main-content" class="skip-link">
      {es.app.skipToContent}
    </a>

    <Navbar currentPath={currentPath} user={user} />

    <main
      id="main-content"
      tabindex="-1"
      class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:px-6"
    >
      <slot />
    </main>

    <footer class="border-t border-border bg-surface-card py-4 text-center text-xs text-ink-muted">
      {es.app.footerNote}
    </footer>
  </body>
</html>
